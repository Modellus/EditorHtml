      {
        "id": "oscillator",
        "type": "circle",
        "when": {
          "choose": {
            "parameter": "orientation"
          },
          "equals": {
            "constant": "longitudinal"
          },
          "then": {
            "constant": 0
          },
          "otherwise": {
            "constant": 1
          }
        },
        "bindings": {
          "centerX": {
            "formula": "i\\cdot spacingPixels",
            "inputs": {
              "i": {
                "parameter": "$index"
              }
            }
          },
          "centerY": {
            "formula": "centerY-d\\cdot ppu",
            "inputs": {
              "i": {
                "parameter": "$index"
              },
              "d": {
                "choose": {
                  "parameter": "wave"
                },
