                                "properties": { "centerX": 66, "centerY": 158, "radiusX": 7, "radiusY": 12, "fill": "token:stroke.default", "stroke": "none", "opacity": 0.28 },
                                "bindings": { "fill": { "parameter": "frameColor" } }
                            },
