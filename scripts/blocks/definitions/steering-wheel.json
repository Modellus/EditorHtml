                        "verticalProperty": "angleUpVariable",
                        "centerX": { "parameter": "cx" },
                        "centerY": { "parameter": "cy" },
                        "degreesPerUnit": 1,
                        "hoverFill": { "parameter": "grabColor" },
                        "hoverOpacity": 0.18
                    }
                ]
            },
