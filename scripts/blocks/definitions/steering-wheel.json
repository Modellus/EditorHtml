                    "y": { "parameter": "pedalsDy" },
                    "width": { "parameter": "halfSide" },
                    "height": { "parameter": "side" }
                },
                "behaviours": [
                    {
                        "type": "press-and-slide",
                        "when": { "parameter": "turnedByHand" },
                        "variable": { "parameter": "pedalVariable" },
                        "property": "pedalVariable",
                        "unitsPerPixel": { "parameter": "unitsPerPixel" },
                        "restValue": { "parameter": "minimum" },
                        "returnStep": { "parameter": "pedalReturn" },
                        "intervalMs": 100,
                        "minimum": { "parameter": "minimum" },
                        "maximum": { "parameter": "maximum" },
                        "hoverFill": { "parameter": "acceleratorColor" },
                        "hoverOpacity": 0.12
                    },
                    {
                        "type": "press-and-slide",
                        "when": { "parameter": "pointedByOrientation" },
                        "variable": { "parameter": "angleVariable" },
                        "property": "angleVariable",
                        "verticalVariable": { "parameter": "angleUpVariable" },
                        "verticalProperty": "angleUpVariable",
                        "unitsPerPixel": { "parameter": "unitsPerPixel" },
                        "restValue": { "parameter": "minimum" },
                        "returnStep": 0,
                        "intervalMs": 100,
                        "minimum": { "parameter": "minimum" },
                        "maximum": { "parameter": "maximum" },
                        "hoverFill": { "parameter": "acceleratorColor" },
                        "hoverOpacity": 0.12
                    }
                ]
            }
        ]
    }
