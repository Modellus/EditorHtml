            {
                "id": "wheel-grab",
                "type": "ring",
                "when": { "parameter": "showWheel" },
                "bindings": {
                    "centerX": { "parameter": "cx" },
                    "centerY": { "parameter": "cy" },
                    "innerRadius": { "parameter": "grabInner" },
                    "outerRadius": { "parameter": "grabOuter" }
                },
                "properties": { "fill": "none", "stroke": "none" },
                "behaviours": [
                    {
                        "type": "drag-rotate",
                        "when": { "parameter": "turnedByHand" },
                        "variable": { "parameter": "angleVariable" },
                        "property": "angleVariable",
                        "centerX": { "parameter": "cx" },
                        "centerY": { "parameter": "cy" },
                        "degreesPerUnit": 1,
                        "hoverFill": { "parameter": "grabColor" },
                        "hoverOpacity": 0.18
                    },
                    {
                        "type": "drag-rotate",
                        "when": { "parameter": "pointedByOrientation" },
                        "variable": { "parameter": "angleVariable" },
                        "property": "angleVariable",
