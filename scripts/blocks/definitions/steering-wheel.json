                                "properties": { "centerX": 100, "centerY": 158, "radiusX": 86, "radiusY": 17, "fill": "token:surface.muted", "stroke": "token:stroke.default", "strokeWidth": 4 },
                                "bindings": { "fill": { "parameter": "surfaceColor" }, "stroke": { "parameter": "frameColor" } }
                            },
                            {
