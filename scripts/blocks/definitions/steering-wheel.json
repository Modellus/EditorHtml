                                        "properties": { "centerX": 134, "centerY": 85, "radius": 12, "fill": "token:stroke.accent", "stroke": "token:stroke.default", "strokeWidth": 3 },
                                        "bindings": { "centerY": { "parameter": "aheadKnobY" }, "radius": { "parameter": "aheadKnobRadius" }, "fill": { "parameter": "acceleratorColor" }, "stroke": { "parameter": "frameColor" } }
                                    }
                                ]
                            }
