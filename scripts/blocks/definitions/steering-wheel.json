                                        "bindings": { "y1": { "parameter": "aheadSlotY" }, "y2": { "parameter": "aheadKnobY" }, "strokeWidth": { "parameter": "aheadArmWidth" }, "stroke": { "parameter": "acceleratorColor" } }
                                    },
                                    {
                                        "id": "ahead-lever-knob",
