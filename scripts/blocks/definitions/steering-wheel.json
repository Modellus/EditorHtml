                        "verticalProperty": "angleUpVariable",
                        "unitsPerPixel": { "parameter": "brakeUnitsPerPixel" },
                        "restValue": { "parameter": "minimum" },
                        "returnStep": 0,
                        "intervalMs": 100,
                        "minimum": { "parameter": "minimum" },
                        "maximum": { "parameter": "maximum" },
                        "hoverFill": { "parameter": "brakeColor" },
                        "hoverOpacity": 0.12
                    }
                ]
            },
            {
