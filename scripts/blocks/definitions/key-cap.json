{
    "schemaVersion": "1.0.0",
    "type": "key-cap",
    "category": "component",
    "displayName": "Key cap",
    "description": "Rounded key with a centred label. It carries no interaction of its own: put it inside a group and give that group the behaviour the key performs, so the same cap serves a keypad, a legend or a toolbar.",
    "icon": "fa-light fa-square",
    "tags": ["key", "button", "label", "panel"],
    "capabilities": ["sizable", "textual"],
    "parameters": [
        { "id": "x", "label": "X", "valueType": "number", "defaultValue": 0, "category": "layout" },
        { "id": "y", "label": "Y", "valueType": "number", "defaultValue": 0, "category": "layout" },
        { "id": "width", "label": "Width", "valueType": "number", "defaultValue": 44, "category": "layout", "minimum": 0 },
        { "id": "height", "label": "Height", "valueType": "number", "defaultValue": 32, "category": "layout", "minimum": 0 },
        { "id": "label", "label": "Label", "valueType": "string", "defaultValue": "", "category": "display" },
        { "id": "fill", "label": "Key colour", "valueType": "colour", "defaultValue": "token:surface.default", "category": "style" },
        { "id": "borderColor", "label": "Border colour", "valueType": "colour", "defaultValue": "token:stroke.subtle", "category": "style" },
        { "id": "borderWidth", "label": "Border width", "valueType": "number", "defaultValue": 1, "category": "style", "minimum": 0 },
        { "id": "cornerRadius", "label": "Corner radius", "valueType": "number", "defaultValue": 6, "category": "style", "minimum": 0 },
        { "id": "labelColor", "label": "Label colour", "valueType": "colour", "defaultValue": "token:text.primary", "category": "style" },
        { "id": "fontSize", "label": "Font size", "valueType": "number", "defaultValue": 14, "category": "style", "minimum": 1 },
        { "id": "fontWeight", "label": "Font weight", "valueType": "number", "defaultValue": 500, "category": "style", "minimum": 100, "maximum": 900 }
    ],
    "locals": [
        { "id": "labelX", "formula": "x+\\frac{width}{2}" },
        { "id": "labelY", "formula": "y+\\frac{height}{2}" }
    ],
    "root": {
        "id": "key-cap",
        "type": "group",
        "children": [
            {
                "id": "cap",
                "type": "rect",
                "bindings": {
                    "x": { "parameter": "x" },
                    "y": { "parameter": "y" },
                    "width": { "parameter": "width" },
                    "height": { "parameter": "height" },
                    "cornerRadius": { "parameter": "cornerRadius" },
                    "fill": { "parameter": "fill" },
                    "stroke": { "parameter": "borderColor" },
                    "strokeWidth": { "parameter": "borderWidth" }
                }
            },
            {
                "id": "label",
                "type": "text",
                "bindings": {
                    "x": { "parameter": "labelX" },
                    "y": { "parameter": "labelY" },
                    "text": { "parameter": "label" },
                    "fontSize": { "parameter": "fontSize" },
                    "fontWeight": { "parameter": "fontWeight" },
                    "fill": { "parameter": "labelColor" }
                },
                "properties": {
                    "stroke": "none",
                    "textAnchor": "middle",
                    "baseline": "central"
                }
            }
        ]
    }
}
